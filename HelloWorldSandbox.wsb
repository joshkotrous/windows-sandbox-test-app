<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\path\to\windows-sandbox-test-app</HostFolder>
      <SandboxFolder>C:\HelloWorldApp</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -ExecutionPolicy Bypass -File C:\HelloWorldApp\sandbox-setup.ps1</Command>
  </LogonCommand>
  <MemoryInMB>4096</MemoryInMB>
  <Networking>Default</Networking>
</Configuration>
